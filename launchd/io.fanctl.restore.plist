<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- 失效保护：每次开机先把风扇交还系统控制，覆盖 SIGKILL / 崩溃 / 断电场景 -->
    <key>Label</key>
    <string>io.fanctl.restore</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/libexec/fanctl/smcfan</string>
        <string>auto</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <false/>
</dict>
</plist>
